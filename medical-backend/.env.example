# Template medical-backend — salin ke .env lalu ubah nilainya. Jangan commit .env asli.

SERVER_PORT=8081

DATABASE_URL=jdbc:postgresql://localhost:15432/nevo
DATABASE_USER=nevo
DATABASE_PASSWORD=change-me

# User & role TIDAK di env — dikelola di tabel m_user (role: ADMIN | FARMASI | OPERATOR).
# Akun dev di-seed oleh V7__db_users.sql; ganti password sebelum dipakai di luar lokal.

# Integrasi SIMRS (kontrak: docs/api-contracts/web-monitoring-integration.md)
# Default aman: semua integrasi MATI. Aktifkan hanya dengan persetujuan pemilik SIMRS.
SIMRS_ENABLED=false
SIMRS_BASE_URL=
SIMRS_MONITORING_TOKEN=
SIMRS_WRITE_ENABLED=false
SIMRS_POLL_INTERVAL_MS=30000
SIMRS_WRITE_MAX_ATTEMPTS=5
SIMRS_CONNECT_TIMEOUT_MS=5000
SIMRS_READ_TIMEOUT_MS=10000
