WS_PORT=8081
WS_PATH=/ws/v1/deliveries
# Bearer token klien MESIN (fase mock). KOSONG = semua koneksi ditolak (close 4401).
WS_AUTH_TOKEN=
# Secret bridge HTTP backend -> gateway (POST /internal/publish, header X-Internal-Secret).
# KOSONG = endpoint menolak semua request (401). Samakan dengan nevo.internal-publish.secret di backend.
INTERNAL_PUBLISH_SECRET=
INTERNAL_PUBLISH_MAX_BYTES=65536
# Kafka opsional. false = gateway hanya melayani bridge HTTP (POST /internal/publish).
# Nyalakan (true) setelah broker tersedia; butuh KAFKA_BROKERS yang hidup.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=medical-ws
KAFKA_GROUP_ID=medical-ws-group
TOPIC_EVENTS=simrs.delivery.events.v1
TOPIC_DLQ=simrs.delivery.events.dlq
DEDUPE_TTL_MS=900000
PING_INTERVAL_MS=15000
PONG_TIMEOUT_MS=15000
LOG_LEVEL=info
NODE_ENV=development
