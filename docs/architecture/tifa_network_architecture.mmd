%% BEGIN DIAGRAM 2 - EXISTING COMMAND FLOW
sequenceDiagram
    actor O as Operator
    participant B as Browser panel
    participant W as Next.js API and WS client
    participant DB as PostgreSQL
    participant G as WS Gateway
    participant K as Kafka
    participant BE as Java Backend
    participant R as Robot custom bridge
    participant A as ROS2 RobotApiNode
    participant N as Local Nav2
    participant M as Local controller and motor
    Note over O,M: EXISTING - OP task path; cloud sessions already established
    Note over W,BE: New UI session requires gateway token validation with Java BE
    O->>B: Select robot and tray destinations
    B->>W: POST /api/robot-control with encoded payload
    W->>DB: Read goals and HOME pose; insert queue
    W->>G: WebSocket OP with robot_id and tray_tasks
    G->>K: Audit and ui.command.op event
    K-->>BE: UICommandConsumer processes event
    G->>R: OP through robot-initiated cloud socket
    Note over G,R: WS send success is not robot execution ACK
    R->>A: Publish JSON String to tifa/ws_in
    A->>A: Enqueue poses in RAM; set MOVING
    A->>N: navigate_to_pose action goal
    N-->>A: Goal acceptance and local feedback
    N->>M: Velocity through mux and watchdog
    M->>M: Serial motor movement
    A-->>R: ACK ENQUEUED via tifa/ws_out
    R-->>G: ACK JSON
    G->>K: robot.command.ack
    N-->>A: Navigation result SUCCEEDED
    A->>A: Set PAUSED; wait for PICKUP_CONFIRM
    A-->>R: GOAL_COMPLETE and cached position when available
    R-->>G: Robot event
    G->>K: robot.events.goal_complete
    K-->>BE: Event consumer updates persistence
    G-->>W: Forward to matching UI session if available
    W->>DB: Handle supported status events
    B->>W: Read task and history API
    W->>DB: Query persisted state
    DB-->>W: State and history
    W-->>B: Render status
    Note over A,BE: Arrival is not proof of physical handover; UI routing depends on ui_id
    Note over W,DB: SQL transaction cannot undo a command already sent to robot
%% END DIAGRAM 2

%% BEGIN DIAGRAM 3 - EXISTING NETWORK FAILURE
flowchart TB
    subgraph FAIL["EXISTING - Communication failures; not robot power failure"]
        F1["Server endpoint unavailable"]
        F2["Robot Wi-Fi disconnected"]
        F3["WebSocket gateway stopped"]
        CUT["Cloud socket unavailable"]
        LOST["Remote tasks and confirmations unavailable; cloud telemetry stale"]
        DROP["TIFA bridge does not persist disconnected outgoing events"]
    end
    subgraph LOCAL["EXISTING - Local components may remain running"]
        ROS["ROS2 processes alive if local dependencies healthy"]
        NAV["Nav2 accepted goal can continue locally"]
        CT["Controller and serial motor remain local"]
        PAUSE["OP pauses at destination until PICKUP_CONFIRM"]
        SAFE["Safety watchdog outputs zero when velocity command is stale"]
        HMI["Local HMI via USB possible if configured and connected"]
        RAM["Task queue in RAM survives link loss; not process restart"]
    end
    F1 --> CUT
    F2 --> CUT
    F3 --> CUT
    CUT --> LOST
    CUT --> DROP
    ROS --> NAV --> CT
    NAV --> PAUSE
    ROS --> RAM
    SAFE --> CT
    HMI -->|"Local confirmation path"| PAUSE
    UNKNOWN["UNKNOWN - DDS over WLAN or hidden service dependencies may affect ROS"]
    F2 -.-> UNKNOWN
    REC["Reconnect and SI after network recovery; TIFA startup ping gate is an exception"]
    CUT --> REC
    REC --> GAP["Session recovery does not guarantee lost-event replay or task reconciliation"]
    style CUT fill:#ffd5d5,stroke:#a33
    style LOST fill:#ffd5d5,stroke:#a33
    style ROS fill:#d9f2df,stroke:#285
    style NAV fill:#d9f2df,stroke:#285
    style UNKNOWN fill:#fff1c7,stroke:#a80
%% END DIAGRAM 3

