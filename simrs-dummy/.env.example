# Compose environment for local demo only. Generate unique values; never commit this file.
SIMRS_DB_PASSWORD=change-this-local-only
MEDICAL_DB_PASSWORD=change-this-local-only
NEXTAUTH_SECRET=change-this-local-only
AUTH_SECRET=change-this-local-only
# Shared SIMRS/monitoring token, only needed when integration is explicitly enabled.
MONITORING_TOKEN=
INTERNAL_PUBLISH_SECRET=
WS_AUTH_TOKEN=
SIMRS_ENABLED=false
SIMRS_WRITE_ENABLED=false
SIMRS_BASE_URL=http://simrs-web:3000
NEXTAUTH_URL=http://localhost:3000
SIMRS_WEB_PORT=3000
MEDICAL_BACKEND_PORT=8082
MEDICAL_WS_PORT=8083

# --- Uji robot fisik (default aman: simulasi, tanpa gerak) ---
# ROBOT_MODE=real            # backend memakai robot fisik lewat gateway (default sim)
# ALLOW_ROBOT_MOTION=true    # izinkan teleop/misi gerak (gateway + dashboard). Hanya saat robot diawasi.
# MEDICAL_WS_BIND=0.0.0.0    # buka gateway ke jaringan agar robot (TFRB5) bisa terhubung
# NEVO_HOME_BASE=0,0,0       # pose dock "x,y,yaw" di peta ROS (kosong = tidak pulang otomatis)
# TELEOP_MAX_LINEAR=0.3      # m/s pada tombol penuh
# TELEOP_MAX_ANGULAR=0.6     # rad/s pada tombol penuh

# QR gelang & jadwal keluarga: alamat yang bisa dibuka HP (IP LAN host)
QR_BASE_URL=
# 0.0.0.0 agar SIMRS bisa dibuka HP di jaringan uji (default hanya localhost)
SIMRS_WEB_BIND=
