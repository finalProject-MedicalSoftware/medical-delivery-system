# Compose environment for local demo only. Generate unique values; never commit this file.
SIMRS_DB_PASSWORD=change-this-local-only
MEDICAL_DB_PASSWORD=change-this-local-only
NEXTAUTH_SECRET=change-this-local-only
AUTH_SECRET=change-this-local-only
# Shared SIMRS/monitoring token, only needed when integration is explicitly enabled.
MONITORING_TOKEN=
INTERNAL_PUBLISH_SECRET=
WS_AUTH_TOKEN=
SIMRS_ENABLED=false
SIMRS_WRITE_ENABLED=false
SIMRS_BASE_URL=http://simrs-web:3000
NEXTAUTH_URL=http://localhost:3000
SIMRS_WEB_PORT=3000
MEDICAL_BACKEND_PORT=8082
MEDICAL_WS_PORT=8083
