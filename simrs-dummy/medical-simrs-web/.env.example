# Wajib untuk docker compose (password user simrs_app di container Postgres)
# SIMRS_DB_PASSWORD=isi_password_di_sini
# Database connection for SIMRS Dummy (Docker Compose container on host port 5433)
# Salin file ini menjadi .env: cp .env.example .env
DATABASE_URL="postgresql://simrs_app:your_db_password_from_root_env@localhost:5433/simrs_dummy?schema=public"

# Auth.js / NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_a_random_secret_with_openssl_rand_base64_32"
AUTH_SECRET="generate_a_random_secret_with_openssl_rand_base64_32"

# Node Environment
NODE_ENV="development"

# Cookie aman (Secure): true HANYA bila diakses via HTTPS (VPS produksi).
# COOKIE_SECURE="false"

# Token layanan integrasi monitoring (dibagikan dengan website monitoring)
# MONITORING_TOKEN="isi_token_bersama_dengan_monitoring_disini"

# Kunci HMAC untuk token QR gelang pasien (fallback ke AUTH_SECRET bila kosong)
# QR_SIGNING_SECRET="generate_a_random_secret_with_openssl_rand_base64_32"
# Masa berlaku token QR dalam detik (default 2592000 = 30 hari)
# QR_TOKEN_TTL_SECONDS="2592000"

# Webhook keluar relay outbox F2 (lihat docs/api-contracts/web-monitoring-integration.md S2.2)
MONITORING_CALLBACK_URL=
MONITORING_CALLBACK_TOKEN=
