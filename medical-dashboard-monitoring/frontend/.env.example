# Frontend BFF — env (tanpa hardcode; nilai di bawah = default deployment Docker)
# URL SIMRS backend REST (proxy BFF + auth/me)
BACKEND_URL=http://127.0.0.1:8082

# WebSocket gateway (medical-ws) — hanya dipakai server-side (BFF). Docker: 8083→container 8081.
WS_BACKEND_URL=ws://127.0.0.1:8083/ws/v1/deliveries
# Bearer token SI-UI gateway (harus sama dengan WS_AUTH_TOKEN di medical-ws/.env)
WS_AUTH_TOKEN=bebaass

# Path relay SSE yang dipakai browser (bisa dioverride saat build).
NEXT_PUBLIC_WS_RELAY_URL=/api/ws/stream
