# Source is mounted by simrs-dummy/compose.dashboard-dev.yaml for hot reload.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=development NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci
EXPOSE 3000
CMD ["sh", "-c", "mkdir -p /app/data && npm run dev -- --hostname 0.0.0.0 --port 3000"]
